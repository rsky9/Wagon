# Mobile
FCM_PROJECT_ID=""

# Mock OTP: in production, set OTP_PROVIDER=sms and wire a real gateway (MSG91/Twilio)
OTP_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="WAGON"
MSG91_FLOW_ID=""

# Payments: mock by default. Set PAYMENT_PROVIDER=razorpay with credentials for real orders/payouts.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# JWT (rotate these in production; keep dev values here)
JWT_ACCESS_SECRET="wagon_dev_access_secret_change_me"
JWT_REFRESH_SECRET="wagon_dev_refresh_secret_change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
