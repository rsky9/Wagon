PORT=4020
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Redis
REDIS_URL="redis://localhost:6380"

# MinIO (dev)
MINIO_ENDPOINT="localhost:9010"
MINIO_ROOT_USER="wagon"
MINIO_ROOT_PASSWORD="wagon_dev_secret"
