// Wagon V2 — PostgreSQL schema (fresh, no legacy migration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  supplier
  transporter
  driver
  admin
}

enum Capability {
  supplier
  transporter
  driver
  forwarder
  warehouse
  carrier
}

enum TruckType {
  open
  container
  trailer
}

enum LoadStatus {
  posted
  paused
  interested
  accepted
  in_transit
  delivered
  completed
  cancelled
}

enum TripStatus {
  accepted
  in_transit
  delivered
  cancelled
}

enum TripStage {
  accepted
  enroute_pickup
  arrived_pickup
  loading
  loaded
  enroute_drop
  arrived_drop
  unloading
  delivered
}

enum PaymentType {
  escrow
  payout
  refund
  settlement
}

enum PaymentMethod {
  mock
  upi
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum KycStatus {
  not_started
  pending
  approved
  rejected
}

enum KycTier {
  basic
  kyc_lite
  kyc_full
}

enum DocumentKind {
  pan
  aadhar
  rc
  license
  bank
  selfie
  company
}

enum CommercialModel {
  fixed_rate
  open_bidding
  invite
}

model User {
  id           String      @id @default(cuid())
  role         UserRole
  capabilities Capability[] @default([transporter])
  mobile       String      @unique
  lang         String      @default("en")
  name         String?
  otpHash      String?
  tier         KycTier     @default(basic)
  kycStatus    KycStatus   @default(not_started)
  rating       Float?
  supplierRating Float?
  tripsCount   Int         @default(0)
  verified     Boolean     @default(false)
  supplierVerified  Boolean @default(false)
  transporterVerified Boolean @default(false)
  xp           Int         @default(0)
  cashbackBalance Float    @default(0)
  xpConverted  Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  supplier     Supplier?
  transporter  Transporter?
  kycDocuments KycDocument[]
  notifications Notification[]
  fcmTokens    FcmToken[]
  tickets      SupportTicket[]
  notifPrefs   NotificationPreference?
  favorites    Favorite[]
  savedSearches SavedSearch[]
  messages     Message[]
  reviewsGiven   Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewee")
  quests       UserQuest[]
  badges       UserBadge[]
  walletTxs    WalletTransaction[]
  reportsMade   Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")
  disputesRaised Dispute[] @relation("RaisedBy")
  exceptionsReported TripException[]
  memberships  OrganizationMember[]
  @@index([role])
}

model Supplier {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String?
  gst                 String?
  pan                 String?
  cin                 String?
  tan                 String?
  billingAddress      String?
  pickupLocations     String[]
  frequentDestinations String[]
  preferredPayment    String?
  attachments         String[]
  bankAccount         String?
  ifsc                String?
  acctHolder          String?
  onboarded           Boolean  @default(false)
  loads               Load[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Transporter {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips        Trip[]
  bids         Bid[]
  quotes       Quote[]
  companyName  String?
  ownerName    String?
  pan          String?
  aadhar       String?
  selfieKey    String?
  fleetSize    Int?
  bankAccount  String?
  ifsc         String?
  acctHolder   String?
  docImageKey  String?
  insuranceKey String?
  permitKey    String?
  fitnessKey   String?
  pollutionKey String?
  onboarded    Boolean  @default(false)
  vehicles     Vehicle[]
  drivers      Driver[]
  trucks       Truck[]
  laneAlerts   LaneAlert[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KycDocument {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      DocumentKind
  storageKey String
  mimeType  String
  size      Int
  status    KycStatus    @default(pending)
  adminNote String?
  verifiedAt DateTime?
  createdAt DateTime     @default(now())
  @@index([userId, kind])
}

model Vehicle {
  id              String   @id @default(cuid())
  transporterId   String
  transporter     Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  rcNumber        String
  rcVerified      Boolean  @default(false)
  insuranceUpto   DateTime?
  permit          String?
  status          KycStatus @default(pending)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([transporterId])
}

model Driver {
  id              String   @id @default(cuid())
  transporterId   String
  transporter     Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  name            String
  mobile          String
  licenseKey      String?
  licenseVerified Boolean  @default(false)
  status          Boolean  @default(true)
  trucks          Truck[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([transporterId])
}

model Truck {
  id           String    @id @default(cuid())
  transporterId String
  transporter  Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  truckNo      String
  type         TruckType
  modelId      String
  capacityId   String?
  driverId     String?
  driver       Driver?   @relation(fields: [driverId], references: [id])
  origin       String?
  lat          Float?
  lng          Float?
  gpsLogin     String?
  attachments  String[]
  activeStatus Boolean   @default(true)
  insuranceUpto DateTime?
  permitUpto    DateTime?
  fitnessUpto   DateTime?
  pollutionUpto DateTime?
  lastServiceAt DateTime?
  nextServiceKm Float?
  odometerKm    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([transporterId])
}

model TruckModel {
  id         String      @id @default(cuid())
  type       TruckType
  model      String
  capacities Float[]
  status     Boolean     @default(true)
  rateCards  RateCard[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  @@unique([type, model])
}

model Material {
  id        String   @id @default(cuid())
  name      String
  imageKey  String?
  status    Boolean  @default(true)
  loads     Load[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Load {
  id          String     @id @default(cuid())
  supplierId  String
  supplier    Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  pickupAddr  String
  dropAddr    String
  haltAddr    String?
  pickupLat   Float
  pickupLng   Float
  dropLat     Float
  dropLng     Float
  haltLat     Float?
  haltLng     Float?
  date        DateTime
  pickupDate  DateTime?
  dropDate    DateTime?
  truckType   TruckType
  modelId     String
  weight      Float
  distanceKm  Float
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  bodyType    String?
  description String?
  loadingReq  String?
  unloadingReq String?
  specialReq  String?
  documents   String[]
  advanceAmount Float?
  contactName String?
  contactPhone String?
  geofenceRadius Float?
  noOfTrucks  Int        @default(1)
  fareEstimate Float
  payLater    Boolean    @default(false)
  ewbNumber   String?
  cancelReason String?
  status      LoadStatus @default(posted)
  // Commercial model + terms
  commercialModel CommercialModel @default(fixed_rate)
  referenceRate   Float?
  biddingDeadline DateTime?
  advancePct      Float?
  paymentTerms    String?
  extraCharges    String?
  // Shortlist / negotiated selection
  shortlistedTransporters String[]
  bids Bid[]
  negotiations NegotiationOffer[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  quotes      Quote[]
  favorites   Favorite[]
  trips       Trip[]
  @@index([truckType, modelId])
  @@index([date])
  @@index([supplierId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  tripId     String?
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([reportedId])
}

model BlockedUser {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
  @@unique([blockerId, blockedId])
}

model Quote {
  id             String     @id @default(cuid())
  loadId         String
  load           Load       @relation(fields: [loadId], references: [id], onDelete: Cascade)
  transporterId  String
  transporter    Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  amount         Float
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@index([loadId])
}

// Structured bid: not just a price — truck, driver, pickup, advance, balance, validity.
model Bid {
  id              String   @id @default(cuid())
  loadId          String
  load            Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  transporterId   String
  transporter     Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  truckId         String?
  driverId        String?
  amount          Float
  advanceAmount   Float?
  balanceAmount   Float?
  pickupBy        String?
  etaHours        Int?
  validityHours   Int      @default(24)
  status          String   @default("pending") // pending | shortlisted | rejected | accepted | withdrawn
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([loadId])
  @@index([transporterId])
}

// Negotiation timeline: structured counteroffers with validity + optional conditions.
model NegotiationOffer {
  id           String   @id @default(cuid())
  loadId       String
  load         Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  bidId        String
  fromRole     String   // supplier | transporter
  amount       Float
  conditions   String?
  validityHours Int     @default(24)
  status       String   @default("offered") // offered | accepted | rejected | expired
  createdAt    DateTime @default(now())
  @@index([loadId])
}

model Trip {
  id           String     @id @default(cuid())
  loadId       String
  load         Load       @relation(fields: [loadId], references: [id], onDelete: Cascade)
  transporterId String
  transporter  Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  driverId     String?
  status       TripStatus @default(accepted)
  stage        TripStage  @default(accepted)
  podUrl       String?
  startedAt    DateTime?
  deliveredAt  DateTime?
  rating       Int?
  review       String?
  pickupOtp    String?
  pickupOtpAt  DateTime?
  pickupOtpVerifiedAt DateTime?
  deliveryOtp  String?
  deliveryOtpAt DateTime?
  deliveryOtpVerifiedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payments     Payment[]
  disputes     Dispute[]
  locations    TripLocation[]
  booking      BookingSnapshot?
  exceptions   TripException[]
  messages     Message[]
  reviews      Review[]
  supplierRating Int?
  supplierReview String?
  transporterRatedAt DateTime?
  supplierRatedAt DateTime?
  @@index([loadId])
  @@index([transporterId])
}

// Real-world logistics exceptions: breakdown, accident, traffic, delay, etc.
model TripException {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reporterId String
  reporter  User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  kind      String   // breakdown | accident | traffic | delay | destination_problem | goods_damage | other
  title     String
  notes     String?
  photos    String[]
  status    String   @default("open") // open | resolved
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([tripId])
}

// Saved / favorite loads for transporters.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  loadId    String
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, loadId])
  @@index([userId])
}

// Saved searches for transporters.
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

// Trip-contextual chat message (persistent — chat is supplementary to structured terms).
model Message {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  @@index([tripId])
}

// Immutable commercial snapshot — the authoritative source of truth for a booking.
model BookingSnapshot {
  id              String   @id @default(cuid())
  tripId          String   @unique
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rate            Float
  advanceAmount   Float?
  balanceAmount   Float?
  paymentTerms    String?
  conditions      String?
  cancellationTerms String?
  truckId         String?
  driverId        String?
  pickupWindow    String?
  deliveryWindow  String?
  supplierConfirmed Boolean @default(false)
  transporterConfirmed Boolean @default(false)
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
}

model TripLocation {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  speedKmh  Float?
  recordedAt DateTime @default(now())
  @@index([tripId, recordedAt])
}

model Payment {
  id              String        @id @default(cuid())
  tripId          String?
  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  settlementId    String?       @unique
  settlement      Settlement?   @relation(fields: [settlementId], references: [id])
  type            PaymentType
  amount          Float
  currency        String        @default("INR")
  gstAmount       Float?
  tdsAmount       Float?
  method          PaymentMethod @default(mock)
  providerRef     String?
  idempotencyKey  String        @unique
  status          PaymentStatus @default(pending)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([tripId])
  @@index([settlementId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  @@index([userId, isRead])
}

// Broadcast history: admin broadcast sends (standalone, no relations).
model Broadcast {
  id        String   @id @default(cuid())
  role      String?
  title     String
  body      String
  sentTo    Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  deviceId  String?
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, token])
}

model LaneAlert {
  id            String    @id @default(cuid())
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  fromLane      String
  truckType     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([transporterId])
}

model RateCard {
  id         String      @id @default(cuid())
  modelId    String
  model      TruckModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  weight     Float?
  pricePerKm Float
  status     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Dispute {
  id           String   @id @default(cuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  raisedBy     String
  raisedByUser User     @relation("RaisedBy", fields: [raisedBy], references: [id], onDelete: Cascade)
  subject      String
  evidenceKeys String[]
  resolution   String?
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tripId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([actorId])
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  category   String   @default("general")
  message    String
  status     String   @default("open")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([userId])
}

model NotificationPreference {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  loadAlerts  Boolean @default(true)
  booking     Boolean @default(true)
  trip        Boolean @default(true)
  payment     Boolean @default(true)
  kyc         Boolean @default(true)
  docExpiry   Boolean @default(true)
  promo       Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  // Role being reviewed: 'transporter' (supplier rates the hauler) or 'supplier' (hauler rates the shipper).
  role        String
  score       Int
  review      String?
  createdAt   DateTime @default(now())

  @@unique([tripId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  completedAt DateTime? 
  createdAt   DateTime  @default(now())

  @@unique([userId, questId])
  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// Reward wallet ledger: XP conversions, trip cashback and redemptions.
model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // xp_conversion | trip_cashback | redeem | adjustment
  kind      String
  amount    Float
  note      String?
  tripId    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// Phase 0 — Universal enablement foundation
// Organizations, Shipments, canonical Events + outbox
// ============================================================

/// A first-class organization: shipper, transporter, forwarder, warehouse, carrier, broker...
model Organization {
  id        String   @id @default(cuid())
  name      String
  kind      String   // shipper | transporter | forwarder | warehouse | carrier | broker | other
  gst       String?
  countryCode String @default("IN")
  verified  Boolean  @default(false)
  verifiedCapabilities Json? // per-kind trust, e.g. ["transporter","forwarder","warehouse","carrier"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  shipments Shipment[] @relation("Origin")
  ownedShipments Shipment[] @relation("OwnerShipments")
  destShipments Shipment[] @relation("Destination")
  legOrigins ShipmentLeg[] @relation("LegOrigin")
  legDestinations ShipmentLeg[] @relation("LegDestination")
  legProviders ShipmentLeg[] @relation("LegProvider")
  facilities Facility[]
  warehouseOps WarehouseOperation[]
  bookings  CarrierBooking[]
  forwarderOrders ForwardOrder[] @relation("ForwarderOrders")
  customerOrders ForwardOrder[] @relation("CustomerOrders")
  consolidations Consolidation[] @relation("Consolidations")
  bookedConsolidations Consolidation[] @relation("BookedConsolidations")
  documents ForwardDocument[]
  connectors IntegrationConnector[]
  webhookSubscriptions WebhookSubscription[]
  orgEvents LogisticsEvent[]
  claimsFiled Claim[] @relation("Claimant")
  claimsHandled Claim[] @relation("Handler")
  policiesUnderwritten InsurancePolicy[]
  settlementsPayer Settlement[] @relation("SettPayer")
  settlementsPayee Settlement[] @relation("SettPayee")
  listings MarketListing[]
  requests MarketRequest[]
  quotes MarketQuote[]
  lanesCreated Lane[]
  carrierServices CarrierService[]
  orgRatingsGiven OrgRating[] @relation("RatingGiver")
  orgRatingsReceived OrgRating[] @relation("RatingSubject")
  @@index([kind])
}

/// A person who belongs to an organization and acts on its behalf.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | operator | member
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Mode-agnostic shipment: the commercial/operational intent. Not tied to a mode.
model Shipment {
  id            String    @id @default(cuid())
  ref           String
  ownerOrgId    String?
  ownerOrg      Organization? @relation("OwnerShipments", fields: [ownerOrgId], references: [id])
  originId      String?
  origin        Organization? @relation("Origin", fields: [originId], references: [id])
  destinationId String?
  destination   Organization? @relation("Destination", fields: [destinationId], references: [id])
  commodity     String?
  description   String?
  weightKg      Float?
  volumeM3      Float?
  pieces        Int?
  pickupWindow  DateTime?
  deliveryWindow DateTime?
  value         Float?
  status        ShipmentStatus @default(draft)
  mode          String    @default("road") // preferred/primary mode; a shipment is not a mode
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  legs      ShipmentLeg[]
  events    LogisticsEvent[]
  warehouseOps WarehouseOperation[]
  bookings  CarrierBooking[]
  documents ForwardDocument[]
  forwardOrder ForwardOrder?
  plans     Plan[]
  claims    Claim[]
  policies  InsurancePolicy[]
  settlements Settlement[]
  riskAssessments RiskAssessment[]
  consolidations Consolidation[]
  activePlanId String?
  activePlan Plan? @relation("ActivePlan", fields: [activePlanId], references: [id])
  @@index([status])
  @@index([ownerOrgId])
  @@unique([ref])
}

/// One physical movement within a shipment — mode + equipment + route.
model ShipmentLeg {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequence   Int
  mode       String   // road | rail | ocean | air | inland_water | multimodal
  originId   String?
  origin     Organization? @relation("LegOrigin", fields: [originId], references: [id])
  destinationId String?
  destination Organization? @relation("LegDestination", fields: [destinationId], references: [id])
  pickupAddr String?
  dropAddr   String?
  distanceKm Float?
  equipment  String?
  providerId String?
  provider   Organization? @relation("LegProvider", fields: [providerId], references: [id])
  bookedAt   DateTime?
  departedAt DateTime?
  arrivedAt  DateTime?
  status     String   @default("planned")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events LogisticsEvent[]
  bookings CarrierBooking[]
  @@index([shipmentId])
  @@unique([shipmentId, sequence])
}

enum ShipmentStatus {
  draft
  planned
  quoted
  booked
  in_transit
  delivered
  closed
  cancelled
}

/// An alternative multimodal plan for a shipment (Phase 4). Selection is the orderer's choice.
model Plan {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  ref         String
  source      String   @default("manual") // manual | ai | re_plan
  // Ordered leg descriptors: [{mode, equipment, carrier, provider, cost, etaHours, departure}]
  legs        Json
  cost        Float?
  currency    String   @default("INR")
  etaHours    Float?
  riskScore   Float    @default(0)
  status      String   @default("proposed") // proposed | selected | superseded | declined
  selectedBy  String?
  selectedAt  DateTime?
  failedLegIndex Int?
  forShipment Shipment[] @relation("ActivePlan")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([shipmentId])
}

/// Canonical event — every important state change becomes one. DCSA/ONE-Record aligned.
model LogisticsEvent {
  id            String    @id @default(cuid())
  eventType     String    // SHIPMENT | TRANSPORT | EQUIPMENT | DOCUMENT | EXCEPTION | FINANCE
  eventCode     String    // e.g. LOADED, DEPARTED, GATE_IN, ARRI, DELIVERED, CUSTOMS_HOLD
  classifier    String    @default("ACT") // PLN | ACT | EST
  entityType    String    // shipment | leg | equipment | organization
  entityId      String
  orgId         String?
  organization  Organization? @relation(fields: [orgId], references: [id])
  shipmentId    String?
  shipment      Shipment?  @relation(fields: [shipmentId], references: [id])
  legId         String?
  leg           ShipmentLeg? @relation(fields: [legId], references: [id])
  occurredAt    DateTime
  receivedAt    DateTime  @default(now())
  source        String    // api | webhook | driver_app | sensor | system
  actorId       String?
  actorName     String?
  location      String?
  confidence    Float     @default(1)
  evidence      String?
  correlationId String?
  payload       Json?
  schemaVersion Int       @default(1)

  @@index([shipmentId])
  @@index([entityType, entityId])
  @@index([eventType, eventCode])
  @@index([orgId])
}

/// Transactional outbox — domain writes + outbox row commit atomically.
model OutboxMessage {
  id        String   @id @default(cuid())
  orgId     String?
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String   @default("pending") // pending | publishing | published | failed | dead
  attempts      Int      @default(0)
  dedupeKey     String?
  lastError     String?
  nextRetryAt   DateTime?
  claimedAt     DateTime?
  createdAt     DateTime @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@index([status, claimedAt])
  @@unique([dedupeKey])
}

// ============================================================
// Phase 2 — Storage / domestic warehouse operations
// ============================================================

/// A physical node in the network: warehouse, CFS, ICD, yard, cross-dock, transload.
model Facility {
  id        String   @id @default(cuid())
  name      String
  kind      String   // warehouse | cold | bonded | cfs | icd | yard | cross_dock | transload
  operatorId String?
  operator  Organization? @relation(fields: [operatorId], references: [id])
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  capacitySlots Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments WarehouseOperation[]
  @@index([kind])
}

/// One warehouse lifecycle: appointment -> gate-in -> receive -> put-away -> stored -> pick -> stage -> load -> gate-out.
model WarehouseOperation {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  ref        String
  status     String   @default("appointment") // appointment | gate_in | receive | put_away | stored | pick | stage | load | gate_out | done
  appointmentAt DateTime?
  gateInAt    DateTime?
  receivedAt  DateTime?
  storedAt    DateTime?
  pickedAt    DateTime?
  stagedAt    DateTime?
  loadedAt    DateTime?
  gateOutAt   DateTime?
  operatorId  String?
  operator    Organization? @relation(fields: [operatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([shipmentId])
}

// ============================================================
// Phase 3 — Freight forwarding
// ============================================================

/// A forwarder's customer order: intake, consolidation intent, buy/sell margin.
model ForwardOrder {
  id          String   @id @default(cuid())
  forwarderId String
  forwarder   Organization @relation("ForwarderOrders", fields: [forwarderId], references: [id])
  customerId  String?
  customer    Organization? @relation("CustomerOrders", fields: [customerId], references: [id])
  shipmentId  String   @unique
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  ref         String
  status      String   @default("intake") // intake | consolidated | booked | in_transit | delivered | closed
  // Buy/sell margin: what the forwarder charges the customer vs pays the carrier.
  buyAmount   Float?
  sellAmount  Float?
  currency    String   @default("INR")
  notes       String?
  consolidationId String?
  consolidation   Consolidation? @relation(fields: [consolidationId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([forwarderId])
}

/// A forwarder's booked capacity on a carrier for a leg.
model CarrierBooking {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  legId       String?
  leg         ShipmentLeg? @relation(fields: [legId], references: [id])
  carrierId   String?
  carrier     Organization? @relation(fields: [carrierId], references: [id])
  bookingRef  String?
  vessel      String?
  voyage      String?
  flight      String?
  equipment   String?
  rate        Float?
  currency    String   @default("INR")
  status      String   @default("requested") // requested | confirmed | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([shipmentId])
}

/// An external system integration connector (Phase 5): TMS, ERP, carrier API, tracking.
model IntegrationConnector {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  kind       String   // tms | erp | carrier_api | tracking | customs
  name       String
  baseUrl    String?
  apiKeyRef  String?  // reference to a stored secret; never store the key itself
  config     Json?
  status     String   @default("active") // active | disabled
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([orgId])
}

/// A webhook subscription to receive logistics events (Phase 5).
model WebhookSubscription {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  name       String
  url        String
  secret     String   @default("") // HMAC secret; rotates via update
  eventTypes Json     // array of event codes, e.g. ["LOAD_CREATED","DELIVERED"]
  status     String   @default("active") // active | paused
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries WebhookDelivery[]
  @@index([orgId])
}

/// One attempted fan-out of a logistics event to a webhook URL.
model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventCode      String
  payload        Json?
  status         String   @default("pending") // pending | sent | failed | dead
  attempts       Int      @default(0)
  dedupeKey      String?
  lastAttemptAt  DateTime?
  responseStatus Int?
  nextRetryAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([subscriptionId, status])
  @@index([status, nextRetryAt])
  @@unique([dedupeKey])
}

/// A trade/transport/customs document on a shipment.
model ForwardDocument {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind       String   // commercial_invoice | packing_list | waybill | bill_of_lading | air_waybill | customs_declaration | certificate
  number     String?
  issuerId   String?
  issuer     Organization? @relation(fields: [issuerId], references: [id])
  storageKey String?
  status     String   @default("draft") // draft | issued | cleared
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([shipmentId])
}

// ============================================================
// Phase 6 — Finance & risk
// ============================================================

/// A claim filed against a shipment (loss/damage/delay). Decide = approve or reject.
model Claim {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  claimantId String?
  claimant   Organization? @relation("Claimant", fields: [claimantId], references: [id])
  handlerId  String?
  handler    Organization? @relation("Handler", fields: [handlerId], references: [id])
  reason     String   // loss | damage | delay | other
  amount     Float?
  currency   String   @default("INR")
  status     String   @default("filed") // filed | assessed | approved | rejected
  decision   String?
  decidedBy  String?
  decidedAt  DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([shipmentId])
}

/// An insurance policy covering a shipment, underwritten by a partner insurer.
model InsurancePolicy {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  insurerId  String?
  insurer    Organization? @relation(fields: [insurerId], references: [id])
  policyRef  String
  premium    Float?
  coverage   Float?
  currency   String   @default("INR")
  status     String   @default("active") // active | expired | claimed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([shipmentId])
}

/// A settlement between two parties on a shipment (freight / advance / balance).
model Settlement {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  payerId    String?
  payer      Organization? @relation("SettPayer", fields: [payerId], references: [id])
  payeeId    String?
  payee      Organization? @relation("SettPayee", fields: [payeeId], references: [id])
  type       String   // freight | advance | balance | commission | claim
  amount     Float?
  currency   String   @default("INR")
  status     String   @default("due") // due | cleared
  settledAt  DateTime?
  payment    Payment?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([shipmentId])
}

/// A risk assessment of a shipment (score 0..1 + factors).
model RiskAssessment {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  score       Float
  factors     Json
  assessedBy  String?
  createdAt   DateTime @default(now())
  @@index([shipmentId])
}

// ============================================================
// Phase 3b — Consolidation / LCL groupage
// ============================================================

/// A grouping of multiple customer orders onto one carrier shipment (LCL/groupage).
model Consolidation {
  id          String   @id @default(cuid())
  ref         String
  forwarderId String
  forwarder   Organization @relation("Consolidations", fields: [forwarderId], references: [id])
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
  mode        String   @default("ocean") // ocean | air | road | rail
  origin      String?
  destination String?
  equipment   String?  // e.g. 20GP | 40HC | ULD | full_truck
  cargoWeightKg Float?
  cargoVolumeM3 Float?
  cargoPieces Int?
  status      String   @default("grouping") // grouping | ready | booked | in_transit | delivered | closed
  bookedCarrierId String?
  bookedCarrier   Organization? @relation("BookedConsolidations", fields: [bookedCarrierId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      ForwardOrder[]
  @@index([forwarderId])
  @@index([status])
}

// ============================================================
// Phase 7 — Guardrailed AI
// ============================================================

/// Audit trail of an agent run: what was recommended, under what constraints,
/// and why. Agents never execute — a human must act on the recommendation.
model AiRecommendation {
  id         String   @id @default(cuid())
  agent      String   // plan | match | risk
  entityType String   // shipment | load
  entityId   String
  summary    String
  score      Float?
  output     Json
  constraints Json?
  rationale  Json?
  guardrails Json?
  status     String   @default("proposed") // proposed | accepted | dismissed
  createdBy  String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

// ============================================================
// Phase 8 — Global: country packs
// ============================================================

/// Per-country operating configuration (currency, units, customs regime,
/// document requirements, lane defaults). Enables the network globally.
model CountryPack {
  id                 String   @id @default(cuid())
  code               String   @unique // ISO 3166-1 alpha-2
  name               String
  currency           String   @default("INR")
  language           String   @default("en")
  unitSystem         String   @default("metric") // metric | imperial
  customsRegime      String   @default("general")
  baseCurrency       String   @default("INR")
  exchangeRateToBase Float?   @default(1)
  documentRequirements Json?  // e.g. ["commercial_invoice","packing_list","customs_declaration"]
  laneDefaults       Json?    // preferred modes per lane
  incotermsSupported Json?    // ["FOB","CIF","EXW",...]
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================
// Marketplace — cross-type capability exchange (all user types)
// ============================================================

/// A first-class origin↔destination pair (lane) that everything references.
model Lane {
  id            String @id @default(cuid())
  originRef     String // normalized place e.g. "Mumbai, MH"
  destinationRef String
  originLat     Float?
  originLng     Float?
  destLat       Float?
  destLng       Float?
  distanceKm    Float?
  mode          String  @default("road") // road | ocean | air | rail | multimodal
  createdByOrgId String?
  createdByOrg  Organization? @relation(fields: [createdByOrgId], references: [id])
  listings      MarketListing[]
  requests      MarketRequest[]
  carrierServices CarrierService[]
  createdAt     DateTime @default(now())
  @@unique([originRef, destinationRef, mode])
  @@index([originRef])
  @@index([destinationRef])
}

/// Supply-side listing: "I provide X on lane Y at price Z".
model MarketListing {
  id              String   @id @default(cuid())
  providerOrgId   String
  providerOrg     Organization @relation(fields: [providerOrgId], references: [id])
  kind            String   // truck_capacity | warehouse_space | carrier_service | forwarder_service
  laneId          String?
  lane            Lane?    @relation(fields: [laneId], references: [id])
  originRef       String?
  destinationRef  String?
  city            String?
  equipment       String?
  capacityAvailable Float?
  capacityUnit    String   @default("kg") // kg | m3 | slots | teu
  price           Float?
  currency        String   @default("INR")
  availableFrom   DateTime?
  availableTo     DateTime?
  status          String   @default("live") // draft | live | paused | expired
  description     String?
  sourceType      String?  // facility | truck | consolidation | carrier_service | manual
  sourceId        String?  // reference to the originating facility/truck/consolidation
  carrierServiceId String?
  carrierService  CarrierService? @relation(fields: [carrierServiceId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  quotes          MarketQuote[]
  @@index([kind, status])
  @@index([providerOrgId])
  @@index([city])
}

/// Demand-side request: "I need X on lane Y" — the universal RFQ (any capability).
model MarketRequest {
  id              String   @id @default(cuid())
  requesterOrgId  String
  requesterOrg    Organization @relation(fields: [requesterOrgId], references: [id])
  kind            String   // transport | warehouse | forwarding | carrier | insurance
  laneId          String?
  lane            Lane?    @relation(fields: [laneId], references: [id])
  originRef       String?
  destinationRef  String?
  city            String?
  capacityNeeded  Float?
  capacityUnit    String   @default("kg")
  date            DateTime?
  budget          Float?
  currency        String   @default("INR")
  description     String?
  status          String   @default("open") // open | quoted | booked | closed
  sourceType      String?  // load | shipment | manual
  sourceId        String?
  quotes          MarketQuote[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([kind, status])
  @@index([requesterOrgId])
}

/// A provider's quote responding to a MarketRequest (the Bid/DecisionRoom pattern).
model MarketQuote {
  id          String   @id @default(cuid())
  requestId   String
  request     MarketRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerOrgId String
  providerOrg Organization @relation(fields: [providerOrgId], references: [id])
  listingId   String?
  listing     MarketListing? @relation(fields: [listingId], references: [id])
  amount      Float?
  currency    String   @default("INR")
  etaHours    Float?
  message     String?
  status      String   @default("submitted") // submitted | accepted | rejected | withdrawn
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([requestId])
  @@index([providerOrgId])
}

/// Org-level reputation: one party rates another org on an axis.
model OrgRating {
  id            String   @id @default(cuid())
  subjectOrgId  String
  subjectOrg    Organization @relation("RatingSubject", fields: [subjectOrgId], references: [id])
  giverOrgId    String?
  giverOrg      Organization? @relation("RatingGiver", fields: [giverOrgId], references: [id])
  axis          String   // transporter | supplier | forwarder | warehouse | carrier
  score         Int      // 1..5
  review        String?
  referenceType String?  // trip | shipment | warehouse_op | booking | quote
  referenceId   String?
  createdAt     DateTime @default(now())
  @@index([subjectOrgId, axis])
}

/// A carrier's scheduled service (vessel/flight) with bookable slots.
model CarrierService {
  id            String   @id @default(cuid())
  carrierOrgId  String
  carrierOrg    Organization @relation(fields: [carrierOrgId], references: [id])
  laneId        String?
  lane          Lane?    @relation(fields: [laneId], references: [id])
  originRef     String?
  destinationRef String?
  mode          String   @default("ocean") // ocean | air | rail
  vessel        String?
  voyage        String?
  flight        String?
  departureAt   DateTime?
  arrivalAt     DateTime?
  equipment     String?
  totalSlots    Int      @default(1)
  availableSlots Int     @default(1)
  rate          Float?
  currency      String   @default("INR")
  status        String   @default("active") // active | sold_out | cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listings      MarketListing[]
  @@index([carrierOrgId])
  @@index([status])
}
